{
  "ci": {
    "collect": {
      "url": [
        "https://typecast-sepia.vercel.app/",
        "https://typecast-sepia.vercel.app/search?type=movie",
        "https://typecast-sepia.vercel.app/title/movie/278"
      ],
      "numberOfRuns": 2
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^https://typecast-sepia\\.vercel\\.app/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.6 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "(search|title)",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-reports"
    }
  }
}
